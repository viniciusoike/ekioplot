Package: ekioplot
Type: Package
Title: EKIO Visual Identity for 'ggplot2'
Version: 1.1.0
Authors@R:
    person(
      "Vinicius", "Oike",
      email = "viniciusor@ekio.io",
      role = c("aut", "cre", "cph"),
      comment = c(ORCID = "0009-0005-8015-9189")
